# Milk Garage — frontend environment
# Copy to `.env.local` for local dev; set the same keys in the Vercel project.
# Both are safe to expose to the browser (Supabase anon / publishable key,
# protected by Row-Level Security). Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
